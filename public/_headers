# Cloudflare Workers static-assets headers.
# Applies ONLY to files served by the ASSETS binding (everything under public/).
# Worker-rendered HTML gets its headers from next.config.ts headers() instead,
# because those responses never touch the assets handler.
#
# Default for public/ was "max-age=0, must-revalidate" — every image revalidated
# on every page load. These paths are content-stable: when an image changes it
# gets a new filename, so a long immutable cache is safe.

/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable
